{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/styayur/terics/blob/main/schema/timetable.schema.json",
  "title": "terics normalized timetable",
  "description": "Shared normalized timetable document used to specify Web/Python parity and cross-language fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "timezone",
    "semesterStart",
    "periods",
    "courses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "semesterStart": {
      "type": "string",
      "format": "date",
      "description": "Monday at the start of teaching week 1."
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "$defs": {
    "clock": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "start", "end"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "start": {
          "$ref": "#/$defs/clock"
        },
        "end": {
          "$ref": "#/$defs/clock"
        },
        "label": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "teacher",
        "location",
        "weekday",
        "startPeriod",
        "endPeriod",
        "weeks",
        "weekRule",
        "note"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "teacher": {
          "type": "string",
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "maxLength": 300
        },
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "1 = Monday, 7 = Sunday."
        },
        "startPeriod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "endPeriod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "weekRule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "sourceRef": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
