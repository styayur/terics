<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><title>青果列表式课表样本</title></head>
<body>
<table id="kblist">
  <tr>
    <th>上课班级代码</th>
    <th>课程</th>
    <th>学分</th>
    <th>课程性质</th>
    <th>考核方式</th>
    <th>教师</th>
    <th>教学班</th>
    <th>选课备注</th>
    <th>人数</th>
    <th>上课时间地点</th>
  </tr>
  <tr>
    <td>CS-2026-01</td>
    <td>[001]高等数学A</td>
    <td>5.0</td>
    <td>必修</td>
    <td>考试</td>
    <td>张伟[1024]</td>
    <td>高数A-1班</td>
    <td></td>
    <td>42</td>
    <td>1-16周 一[1-2节] 教1-101；1-16周 三[3-4节] 教1-101</td>
  </tr>
  <tr>
    <td>CS-2026-01</td>
    <td>[002]程序设计基础</td>
    <td>3.0</td>
    <td>必修</td>
    <td>考试</td>
    <td>孙七[2048]</td>
    <td>程序设计-2班</td>
    <td></td>
    <td>38</td>
    <td>1-16周(单) 二[5-6节] 计算机楼305；1-16周(双) 四[5-6节] 实验楼B203</td>
  </tr>
  <tr>
    <td>CS-2026-01</td>
    <td>[003]大学英语</td>
    <td>2.0</td>
    <td>必修</td>
    <td>考试</td>
    <td>李华[4096]</td>
    <td>英语-3班</td>
    <td></td>
    <td>35</td>
    <td>2-16周 四[3-4节] 外语楼204</td>
  </tr>
</table>
</body>
</html>
