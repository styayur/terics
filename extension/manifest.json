{
  "manifest_version": 3,
  "name": "terics Timetable Bridge",
  "version": "0.5.1",
  "description": "Extract a logged-in Chinese university timetable locally and export .terics.json or ICS.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "terics — 提取当前课表",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "version_name": "0.5.0-rc.2"
}
